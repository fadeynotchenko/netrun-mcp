{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fadeynotchenko/netrun",
  "title": "Netrun",
  "description": "Publish websites and Telegram bots to Netrun — upload a folder from your editor, get a URL",
  "repository": {
    "url": "https://github.com/fadeynotchenko/netrun-mcp",
    "source": "github"
  },
  "websiteUrl": "https://netrun.io/mcp",
  "version": "0.3.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "netrun-mcp",
      "version": "0.3.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "NETRUN_API_KEY",
          "description": "Personal access key from netrun.io → MCP (starts with nru_)",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.netrun.io/v1/mcp"
    }
  ]
}
